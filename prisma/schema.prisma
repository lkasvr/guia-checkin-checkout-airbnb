generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────── Auth.js: anfitrião (tenant) ───────────────────

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // login email+senha (bcrypt)
  role          UserRole    @default(HOST)
  apartments    Apartment[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum UserRole {
  HOST
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────── Apartamento (escopado ao host) ───────────────────

model Apartment {
  id        String        @id @default(cuid())
  hostId    String
  slug      String        @unique // subdomínio: <slug>.anfyi.com.br
  active    Boolean       @default(true)
  label     String // rótulo interno ("Ap 1305C · DF Plaza")
  content   Json // guia bilíngue em JSONB — shape = ApartmentContent (src/data/types.ts)
  internalNotes String? // observações e itens em manutenção — uso interno, nunca aparece no guia público
  // { rules?: true, home?: true, amenities?: true, tourism?: true, dining?: true }
  // true = esta seção usa o `content` próprio do apartamento em vez de herdar
  // ao vivo do prédio. Sem a chave (ou nulo) = herda, igual comportamento de
  // antes desse campo existir.
  overrides Json?
  buildingId String?
  host      User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  building  Building?     @relation(fields: [buildingId], references: [id])
  stays     Stay[]
  catalog   CatalogItem[]
  orders    Order[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([hostId])
  @@index([active])
  @@index([buildingId])
}

// ─────────── Prédio: conteúdo compartilhado entre apartamentos ───────────

model Building {
  id               String      @id @default(cuid())
  name             String      @unique
  // Ao vivo: editar aqui reflete em todos os apartamentos ligados na hora.
  // `rules` são as regras genéricas do prédio (silêncio, lixo, garagem...) —
  // somadas às regras específicas de cada apartamento, não substituem elas.
  rules            Json? // { sub: L, items: Rule[] } — nulo em prédios criados antes deste campo existir
  home             Json? // { sub: L, slides: Slide[], accordions: Accordion[] } — idem, nulo em prédios antigos
  amenities        Json // { sub: L, items: Amenity[] } — mesma forma de Apartment.content.amenities
  tourism          Json // { sub: L, items: Place[] }
  dining           Json // { sub: L, items: Place[] }
  // Template: copiado (com marcadores {{TORRE}} etc. substituídos) para
  // Apartment.content.checkin/checkout na criação/edição — não é ao vivo.
  checkinTemplate  Json
  checkoutTemplate Json
  // Capa/despedida padrão do modelo — só usadas pelo "Copiar de" ao criar
  // um apartamento; cada apartamento guarda a própria depois, sem ficar
  // ao vivo ligado ao prédio (não faz sentido todo apartamento ter a
  // mesma foto de capa).
  defaultHeroImg   String?
  defaultFooterImg String?
  apartments       Apartment[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// ─────────── Estadia: dados dinâmicos + janela de disponibilidade ───────────

model Stay {
  id          String     @id @default(cuid())
  apartmentId String
  guestName   String?
  checkInAt   DateTime // início da hospedagem
  checkOutAt  DateTime // fim da hospedagem
  doorCode    String? // senha da fechadura (revelada só dentro do período)
  accessCode  String     @unique // código/magic-link do hóspede p/ a área autenticada
  status      StayStatus @default(SCHEDULED)
  vars        Json? // variáveis extras configuráveis por estadia
  apartment   Apartment  @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  orders      Order[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([apartmentId])
  @@index([apartmentId, checkInAt, checkOutAt])
}

enum StayStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELED
}

// ─────────── Catálogo & Pedidos (schema pronto; UI em etapa futura) ───────────

model CatalogItem {
  id          String      @id @default(cuid())
  apartmentId String
  kind        CatalogKind @default(SERVICE)
  name        Json // bilíngue { pt, en }
  description Json?
  priceCents  Int         @default(0)
  currency    String      @default("BRL")
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  apartment   Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([apartmentId])
}

enum CatalogKind {
  SERVICE
  PRODUCT
}

model Order {
  id          String      @id @default(cuid())
  apartmentId String
  stayId      String?
  status      OrderStatus @default(PENDING)
  totalCents  Int         @default(0)
  note        String?
  apartment   Apartment   @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  stay        Stay?       @relation(fields: [stayId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([apartmentId])
  @@index([stayId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELED
}

model OrderItem {
  id             String       @id @default(cuid())
  orderId        String
  catalogItemId  String?
  nameSnapshot   String // nome no momento do pedido
  unitPriceCents Int
  qty            Int          @default(1)
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem    CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}
